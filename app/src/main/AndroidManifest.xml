<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to launch the system package installer ourselves for in-app update installs,
         since Reelia isn't distributed through the Play Store. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Runtime-requested (API 33+) only when the user opts into release-date reminders in
         Profil > Paramètres — never requested proactively on launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: Android's default Auto Backup restores Room/DataStore/Firebase
         Auth's session file on reinstall from a stale Google Drive snapshot — this silently
         undid "reset library" (a fresh install looked auto-signed-in with the pre-reset data
         back) and is redundant anyway since everything meaningful already syncs via Firestore. -->
    <application
        android:name=".TimeLineApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeLine">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TimeLine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- TimeLineApplication implements Configuration.Provider (see its HiltWorkerFactory
             wiring) and initializes WorkManager on demand itself — this removes the default
             eager androidx.startup initializer, which AGP's release lint check otherwise flags
             as a fatal error (RemoveWorkManagerInitializer). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
