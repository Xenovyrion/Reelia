<?xml version="1.0" encoding="utf-8"?>
<!-- Required by AppWidgetProviderInfo.initialLayout — briefly shown before Glance's own
     provideContent() composition takes over, so this only needs to look reasonable for an
     instant, not match the final widget pixel-for-pixel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#13111C">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</FrameLayout>
